{
  "version": 2,
  "builds": [
    { "src": "index.html",     "use": "@vercel/static" },
    { "src": "api/predict.js", "use": "@vercel/node"   }
  ],
  "routes": [
    { "src": "/api/predict", "dest": "/api/predict.js" },
    { "src": "/api/(.*)",    "dest": "/api/$1.js"      },
    { "src": "/(.*)",        "dest": "/index.html"     }
  ]
}
